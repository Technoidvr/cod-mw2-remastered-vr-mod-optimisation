#pragma code_page(65001)

#include <windows.h>

#define IDI_INSTALLER_ICON 101

1 24 "optilord_installer.manifest"
IDI_INSTALLER_ICON ICON "../../assets/icon/Icon.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,5,0,0
 PRODUCTVERSION 0,5,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS VS_FF_DEBUG
#else
 FILEFLAGS VS_FF_PRERELEASE
#endif
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "TechnoidVR (based on Overlord VR by Aeka0)"
            VALUE "FileDescription", "OptiLord Clean Installer & Uninstaller"
            VALUE "FileVersion", "0.5.0"
            VALUE "InternalName", "optilord_installer"
            VALUE "LegalCopyright", "Copyright (C) 2026 Aeka0 and Overlord contributors; TechnoidVR"
            VALUE "OriginalFilename", "OptiLord-Setup.exe"
            VALUE "ProductName", "OptiLord VR Installer"
            VALUE "ProductVersion", "0.5.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
